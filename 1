@echo off
title SecurData Pro - FREE Diagnostic Scanner
color 0A
set "folder=Report_Diagnostico_%date:~-4%-%date:~3,2%-%date:~0,2%"
mkdir "%folder%" 2>nul

echo ==========================================
echo    SECURDATA PRO - ANALISI IN CORSO...
echo ==========================================

:: 1. HARDWARE SECTION
