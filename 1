echo --- CPU --- > "%folder%\Hardware.txt"
wmic cpu get name, numberofcores, maxclockspeed /format:list >> "%folder%\Hardware.txt"
echo --- RAM --- >> "%folder%\Hardware.txt"
wmic memorychip get capacity, speed, manufacturer /format:list >> "%folder%\Hardware.txt"
echo --- DISCHI --- >> "%folder%\Hardware.txt"
wmic diskdrive get model, size, status /format:list >> "%folder%\Hardware.txt"

:: 2. SOFTWARE & APPS SECTION
echo [+] Analisi Software e App...
echo --- APP INSTALLATE --- > "%folder%\Software.txt"
wmic product get name, version, installDate >> "%folder%\Software.txt"
echo --- SERVIZI ATTIVI --- >> "%folder%\Software.txt"
tasklist /v >> "%folder%\Software.txt"

:: 3. SISTEMA E RETE
echo [+] Analisi Sistema e Rete...
systeminfo > "%folder%\Sistema_Completo.txt"
ipconfig /all > "%folder%\Rete.txt"

echo ==========================================
echo    ANALISI COMPLETATA! Controlla la cartella:
echo    %folder%
echo ==========================================
pause
